# Set this to the public host at build time so robots.txt allows indexing.
# Leave unset on previews. Canonical links always use https://flo-brannsikring.no.
NEXT_PUBLIC_SITE_URL=
# Optional: skip the compiler disk cache on machines with little free space.
FLO_LOW_DISK_MODE=0

# EmailJS public identifiers, read at build time. Never put a private API key here.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# Production editorial login fails closed until both unique secrets are set.
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLO_DESK_SECRET=
FLO_DESK_KEY=
# Each customer needs a stable ID and a DIFFERENT random passphrase, at least 24 characters.
# Example shape: [{"id":"customer-a","passphrase":"..."}]
FLO_DESK_CUSTOMERS=[]
